# Build artifacts and deps are regenerated inside the image — never copy the
# host copies (they bloat the COPY layer and can shadow the container's).
node_modules
.next
out

# VCS / editor / OS noise
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Logs and local caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo

# Docker files themselves
Dockerfile
.dockerignore
