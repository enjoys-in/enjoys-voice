# Environment variables for Enjoys Voice Go API

PORT=3003
DATABASE_URL=postgres://postgres:postgres@localhost:5432/enjoys_voice?sslmode=disable
# VALKEY_URL wins over the fields below (supports an ACL username + rediss:// TLS),
# e.g. VALKEY_URL=redis://enjoys:<password>@185.193.19.118:6379
VALKEY_URL=
VALKEY_ADDR=localhost:6379
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_DB=0
JWT_SECRET=change-this-to-a-secure-random-string
UPLOAD_DIR=./uploads/sounds

# ─── IVR audio prompts (sounds) ──────────────────────────
# ffmpeg normalizes IVR sound uploads (recorded/uploaded prompts) to the
# FreeSWITCH-canonical WAV (16 kHz mono pcm_s16le). Resolved on PATH; IVR
# uploads are rejected (503) when it is unavailable.
FFMPEG_PATH=ffmpeg
# Where normalized IVR prompts (.wav) are WRITTEN. This MUST be a directory the
# FreeSWITCH container can read — FS plays prompts server-side from
# /usr/share/freeswitch/sounds/ivr/… .
#   • native dev (go run . from server/): leave UNSET — the default
#     ../docker/freeswitch_sounds/ivr writes into the dir the dockerized FS
#     mounts as its sounds root, so prompts play immediately. Overriding this to
#     a path outside that tree → FS logs "play failed … File Not Found".
#   • docker/prod: set ./uploads/ivr and bind-mount it into the FS sounds dir
#     (see docker/docker-compose.*.yml).
# IVR_SOUND_DIR=../docker/freeswitch_sounds/ivr
# Built-in FreeSWITCH sound library the IVR builder lists + previews (the
# "System library" picker / GET /system-sounds). Read-only.
#   • native dev: leave UNSET — defaults to ../docker/freeswitch_sounds/en/us/callie
#   • docker/prod: point at the mounted callie voice dir.
# FS_SYSTEM_SOUNDS_DIR=../docker/freeswitch_sounds/en/us/callie
