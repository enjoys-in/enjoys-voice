# Environment variables for Enjoys Voice Go API

PORT=3003
DATABASE_URL=postgres://postgres:postgres@localhost:5432/enjoys_voice?sslmode=disable
# VALKEY_URL wins over the fields below (supports an ACL username + rediss:// TLS),
# e.g. VALKEY_URL=redis://enjoys:<password>@185.193.19.118:6379
VALKEY_URL=
VALKEY_ADDR=localhost:6379
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_DB=0
JWT_SECRET=change-this-to-a-secure-random-string
UPLOAD_DIR=./uploads/sounds
