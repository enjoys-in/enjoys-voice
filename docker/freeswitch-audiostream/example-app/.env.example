# ── HTTP / WS / ESL ports ────────────────────────────────────────────────────
HTTP_PORT=3000
WS_PORT=8080
ESL_PORT=8085

# Hostname FreeSWITCH uses to reach this app's WS over the Docker network.
# Must match the node app's service/container name in docker-compose.
WS_HOST_FOR_FS=node-app

# ── Audio stream / recording ─────────────────────────────────────────────────
# Must match the values passed to uuid_audio_stream (mono|mixed|stereo, rate).
# stereo = caller on the left channel, callee/AI on the right (both sides).
AUDIO_CHANNELS=stereo
AUDIO_SAMPLE_RATE=8000
# mod_audio_stream emits native-endian (LE) L16, so leave this false. Set true
# only if recordings sound like pure static (a build/host that emits big-endian).
AUDIO_SWAP_ENDIANNESS=false

RECORDING_ENABLED=true
# Written under the app's public/ dir so files are reachable at /recording_*.wav
RECORDING_DIR=public

# ── TTS (Piper via mod_tts_commandline) ──────────────────────────────────────
TTS_VOICE=en_US-amy-medium
TTS_GREETING=Hello, welcome to the ENJOYS AI line by Mulayam. Please start speaking; I am listening.
